---
interface Props {
  title: string;
  description?: string;
  date: Date;
  slug: string;
  category?: string;
  readingTime?: number;
}

const { title, description, date, slug, category, readingTime } = Astro.props;

const categoryColors: Record<string, string> = {
  "UX Design": "#7c3aed",
  Développement: "#2563eb",
  Management: "#d97706",
  "IA & Outils": "#16a34a",
  Apprentissages: "#0891b2",
};

const color = category ? (categoryColors[category] ?? "#B14AED") : "#B14AED";

const formattedDate = date.toLocaleDateString("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<div class="block border-b border-[#e5e5e5] rounded-2xl overflow-hidden">
  <div class="p-6 flex items-baseline justify-between gap-4">
    {
      category && (
        <p
          class="text-xs font-semibold tracking-widest uppercase mb-3"
          style={`color: ${color}`}
        >
          {category}
        </p>
      )
    }
    <h3 class="text-2xl leading-snug mb-3 italic">
      {title}
    </h3>
    <p class="text-color ml-auto">
      {formattedDate}{readingTime ? ` · ${readingTime} min de lecture` : ""}
    </p>
      <a
    href={`/articles/${slug}`}
    class="rounded-full border border-2 border-[#D74E09] px-4 py-2 font-semibold text-[#D74E09] hover:bg-[#D74E09] hover:text-white transition"
    aria-label={`Lire l'article ${title}`}>Voir l'article</a>
  </div>
</div>
