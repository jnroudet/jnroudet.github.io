---
interface Props {
  title: string;
  description?: string;
  date: Date;
  slug: string;
  category?: string;
  readingTime?: number;
}

const { title, description, date, slug, category, readingTime } = Astro.props;

const categoryColors: Record<string, string> = {
  "UX Design": "#7c3aed",
  "Développement": "#2563eb",
  "Management": "#d97706",
  "IA & Outils": "#16a34a",
  "Apprentissages": "#0891b2",
};

const color = category ? (categoryColors[category] ?? "#6b47dc") : "#6b47dc";

const formattedDate = date.toLocaleDateString("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<a href={`/articles/${slug}`} class="group block bg-white border border-[#e5e5e5] rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
  <div class="p-6">
    {category && (
      <p class="text-xs font-semibold tracking-widest uppercase mb-3" style={`color: ${color}`}>
        {category}
      </p>
    )}
    <h3 class="font-bold text-lg leading-snug mb-3 group-hover:text-[#6b47dc] transition-colors">
      {title}
    </h3>
    {description && (
      <p class="text-sm text-[#666] leading-relaxed mb-4 line-clamp-3">{description}</p>
    )}
    <p class="text-xs text-[#999]">
      {formattedDate}{readingTime ? ` · ${readingTime} min de lecture` : ""}
    </p>
  </div>
</a>
