---
---

<section class="mx-auto max-w-6xl px-6 pt-12 pb-10 overflow-hidden">
  <div class="grid gap-4" style="grid-template-columns: 260px 1fr 1fr 1fr; grid-template-rows: auto 220px auto;">

    <!-- Carte About Me — colonne gauche, toute la hauteur -->
    <div class="row-span-3 relative flex flex-col">
      <!-- Badge flottant hors de la carte -->
      <div class="absolute top-0 left-0 z-10 flex items-center gap-2 rounded-full px-3 py-1.5 text-sm font-medium text-[#333]">
        <span class="text-[#5535c4]">✦</span> À propos
      </div>
      <div class="rounded-3xl p-7 flex flex-col justify-between flex-1" style="background: #5535c4; min-height: 580px; clip-path: polygon(100% 0%, 100% 100%, 0% 100%, 0% 8%, 45% 8%, 55% 0%);">
      <div style="padding-top: 5rem;">
        <!-- Photo -->
        <div class="w-36 h-36 rounded-full overflow-hidden border-4 border-white/20 mx-auto mb-6">
          <img src="/images/profile.jpg" alt="Jennifer Buisson" class="w-full h-full object-cover object-top" />
        </div>
      </div>

      <div>
        <p class="font-caveat text-2xl text-white/80 mb-1">Je suis,</p>
        <h2 class="text-3xl font-bold text-white leading-tight mb-4">Développeuse,<br />Manager,<br />et artiste.</h2>
        <p class="text-sm text-white/70 mb-6">jnroudet@gmail.com</p>

        <!-- Badge circulaire -->
        <div class="flex items-center gap-3">
          <div class="flex gap-3">
            <a href="https://www.linkedin.com/in/jennifer-buisson-engineering-manager/" target="_blank" rel="noopener noreferrer"
              class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 transition flex items-center justify-center text-white">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://github.com/jnroudet" target="_blank" rel="noopener noreferrer"
              class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 transition flex items-center justify-center text-white">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
    </div>

    <!-- Grand titre — col 2-3, row 1 -->
    <div class="col-span-3 rounded-3xl px-8 py-6 flex items-center justify-between">
      <h1 class="text-6xl font-bold leading-none tracking-tight">
        Jennifer Buisson<span class="text-[#5535c4]">.</span>
      </h1>
      <div class="text-right shrink-0 ml-6">
        <p class="text-sm text-[#888] uppercase tracking-widest mb-1">Montpellier · Remote</p>
        <p class="text-sm font-medium text-[#444]">Engineering Manager<br />Lead Frontend</p>
      </div>
    </div>

    <!-- Image hero — col 2, row 2 -->
    <div class="rounded-3xl col-span-2 overflow-hidden" style="height: 220px;">
      <img src="/images/hero.jpg" alt="Espace de travail" class="w-full h-full object-cover" />
    </div>

    <!-- Stats — col 3, row 2 (2 cards empilées) -->
    <div class="flex flex-col">
      <div class="flex-1 rounded-t-3xl flex flex-col justify-center px-7 py-5" style="background: #63bed4;">
        <p class="text-5xl font-bold text-black">10</p>
        <p class="text-sm font-medium text-black mt-1">ans d'expérience</p>
      </div>
      <div class="flex-1 rounded-b-3xl flex flex-col justify-center px-7 py-5" style="background: #5535c4;">
        <p class="text-5xl font-bold text-white">20</p>
        <p class="text-sm font-medium text-white/70 mt-1">projets en prod</p>
      </div>
    </div>

    <!-- CTA Articles — col 2, row 3 -->
    <div class="rounded-3xl overflow-hidden relative flex flex-col justify-between p-7" style="background: #111; ">
      <div class="absolute inset-0 flex items-center justify-center opacity-10">
        <span class="material-icons-round text-white" style="font-size: 8rem;">article</span>
      </div>

      <p class="text-white font-bold text-lg mb-4">Mes réflexions & apprentissages</p>
      <a href="/articles" class="inline-flex items-center gap-2 bg-[#5535c4] text-white text-sm font-medium px-5 py-2.5 rounded-full hover:bg-[#4429a8] transition w-fit">
        Lire les articles →
      </a>
    </div>

    <!-- Quote / CTA Projets — col 3, row 3 -->
    <div class="rounded-3xl col-span-2 p-7 flex flex-col justify-between" style="background: #ffba52; position: relative;">
      <p class="text-black font-medium text-sm leading-relaxed absolute right-1" style="max-width: 50%;">
        Apprendre en faisant des erreurs
        Partager pour apporter de la valeur.
      </p>
      <p class="text-black font-bold text-lg mb-4">Mes travaux</p>
      <a href="/projects" class="inline-flex items-center gap-2 bg-black text-white text-sm font-medium px-5 py-2.5 rounded-full hover:bg-[#333] transition w-fit whitespace-nowrap">
        Mes projets →
      </a>
    </div>

  </div>
</section>
