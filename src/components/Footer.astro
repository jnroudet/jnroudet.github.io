---
---

<footer class="border-t border-[#e5e5e5] mt-16">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- À propos -->
      <div class="md:col-span-1">
        <h3 class="font-bold mb-4">À propos</h3>
        <p class="text-sm text-[#666] leading-relaxed mb-4">
          Passionnée par la création de produits utiles et l'impact qu'ils peuvent avoir, je m'intéresse autant à l'expérience utilisateur qu'à l'architecture, à la stratégie et aux humains derrière les projets.
        </p>
        <a href="/about" class="text-sm font-medium hover:text-[#B14AED] transition">
          En savoir plus sur moi →
        </a>
      </div>

      <!-- Connectons-nous -->
      <div>
        <h3 class="font-bold mb-4">Connectons-nous</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a
              href="https://www.linkedin.com/in/jennifer-buisson-engineering-manager/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-[#555] hover:text-black transition"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
              </svg>
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href="https://github.com/jnroudet"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-[#555] hover:text-black transition"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
              </svg>
              GitHub
            </a>
          </li>
          <li>
            <a
              href="mailto:jnroudet@gmail.com"
              class="flex items-center gap-2 text-[#555] hover:text-black transition"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
              Email
            </a>
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <h3 class="font-bold">Newsletter</h3>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-[#5535c4]/10 text-[#B14AED]">Bientôt</span>
        </div>
        <p class="text-sm text-[#666] mb-4">
          Des réflexions et ressources, 1 fois par mois dans votre boîte mail.
        </p>
        <form class="flex gap-2 opacity-50 pointer-events-none" aria-disabled="true">
          <input
            type="email"
            placeholder="Votre adresse email"
            disabled
            class="flex-1 text-sm px-4 py-2.5 border border-[#e5e5e5] rounded-full bg-[#f8f8f8] cursor-not-allowed"
          />
          <button
            type="button"
            disabled
            class="bg-[#111] text-white text-sm font-medium px-5 py-2.5 rounded-full whitespace-nowrap cursor-not-allowed"
          >
            S'abonner
          </button>
        </form>

        <!-- Quote -->
        <div class="mt-8 text-right">
          <p class="font-caveat text-4xl text-[#111] leading-tight">
            "Merci !"
          </p>
          <svg class="inline-block mt-2 text-[#e5e5e5]" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-[#e5e5e5] flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#999]">
      <p>© {new Date().getFullYear()} Jennifer Buisson</p>
      <div class="flex gap-6">
        <a href="/legal" class="hover:text-black transition">Mentions légales</a>
        <a href="/privacy" class="hover:text-black transition">Confidentialité</a>
      </div>
    </div>
  </div>
</footer>
