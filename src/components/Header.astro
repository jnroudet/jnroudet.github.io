---
const links = [
  { href: "/", label: "Accueil" },
  { href: "/articles", label: "Journal" },
  { href: "/projects", label: "Projets" },
  { href: "/about", label: "À propos" },
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-color">
  <nav class="relative mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="text-xl font-bold tracking-tight">JB.</a>

    <ul class="hidden md:flex absolute left-1/2 -translate-x-1/2 items-center gap-8 text-sm font-medium uppercase tracking-wide">
      {
        links.map((link) => {
          const isActive =
            link.href === "/"
              ? pathname === "/"
              : pathname.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                class={`transition border-2 border-transparent px-3 py-1 rounded-[2vw] hover:border-[#D74E09] ${
                  isActive
                    ? "text-accent font-semibold"
                    : "text-color"
                }`}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>

  </nav>
</header>
