---
const links = [
  { href: "/", label: "Accueil" },
  { href: "/articles", label: "Journal" },
  { href: "/projects", label: "Projets" },
  { href: "/about", label: "À propos" },
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-[#f3f0ff]">
  <nav class="relative mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="text-xl font-bold tracking-tight">JB.</a>

    <ul class="hidden md:flex absolute left-1/2 -translate-x-1/2 items-center gap-8 text-xs font-medium uppercase tracking-wide">
      {
        links.map((link) => {
          const isActive =
            link.href === "/"
              ? pathname === "/"
              : pathname.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                class={`transition hover:text-black ${
                  isActive
                    ? "text-[#5535c4] font-semibold"
                    : "text-[#555555]"
                }`}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>

  </nav>
</header>
