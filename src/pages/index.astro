---
import { getCollection } from "astro:content";
import Hero from "../components/Hero.astro";
import PostCard from "../components/PostCard.astro";
import Layout from "../layouts/layout.astro";

const allPosts = await getCollection("posts");
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const themes = [
  { icon: "brush", label: "Design", count: 0, color: "#7c3aed" },
  { icon: "code", label: "Développement", count: 0, color: "#2563eb" },
  { icon: "groups", label: "Management", count: 0, color: "#d97706" },
  { icon: "psychology", label: "IA & Outils", count: 0, color: "#16a34a" },
  { icon: "menu_book", label: "Apprentissages", count: 0, color: "#0891b2" },
  { icon: "sticky_note_2", label: "Notes", count: 0, color: "#C084FC" },
];

const projects = [
  {
    title: "A venir",
    description: "Projet en cours de développement, je suis impatiente de pouvoir en parler très vite !",
    status: "Projet en cours",
    statusColor: "#7c3aed",
    imageUrl: "https://images.pexels.com/photos/33773995/pexels-photo-33773995.jpeg",
  },
  {
    title: "Tableau de bord personnel",
    description: "Outil de suivi de mes projets, idées, inspirations et apprentissages. Un espace pour m'organiser et rester créative.",
    status: "Side project",
    statusColor: "#2563eb",
    imageUrl: "https://images.pexels.com/photos/8850721/pexels-photo-8850721.jpeg",
  },
  {
    title: "Suivi de candidatures",
    description: "Outil pour suivre mes candidatures multi sites, création de CV et lettres de motivation assistée par l'IA.",
    status: "Side project",
    statusColor: "#2563eb",
    imageUrl: "https://images.pexels.com/photos/5989943/pexels-photo-5989943.jpeg",
  },
];
---

<Layout title="Jennifer Buisson. Développeuse, Artiste, Manager.">
  <Hero />

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-6xl font-bold overflow-hidden whitespace-nowrap
">
        Derniers articles <span class="text-[#B14AED]">.</span>         Derniers articles <span class="text-[#B14AED]">.</span>

      </h2>
    </div>

    {latestPosts.length > 0 ? (
      <div class="flex flex-col gap-4">
        {latestPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.id}
            category={post.data.category}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 text-[#999]">
        <p class="text-lg">Les articles arrivent bientôt.</p>
        <p class="text-sm mt-2">Je suis en train de préparer du contenu pour vous.</p>
      </div>
    )}
  </section>

  <!-- Projets en cours -->
  <section class="mx-auto max-w-6xl px-6">

    <div class="relative" style="height: 520px;">

      <!-- Grand texte en overlay -->
      <h2 class="absolute inset-0 flex items-center justify-center font-bold pointer-events-none select-none z-10"
        style="font-size: 7em; color: var(--color-orange); line-height: 1;">
        Projets
      </h2>

      <!-- Ligne du haut : 3 images -->
      <div class="flex" style="height: 240px;">
        <div class="flex-1 overflow-hidden" style="border-radius:40px;">
          <img src={projects[0].imageUrl} alt={projects[0].title} class="w-full h-full object-cover grayscale" />
        </div>
        <div class="flex-1 overflow-hidden" style="border-radius: 40px;">
          <img src={projects[1].imageUrl} alt={projects[1].title} class="w-full h-full object-cover grayscale" />
        </div>
        <div class="flex-1 overflow-hidden" style="border-radius: 40px;">
          <img src={projects[2].imageUrl} alt={projects[2].title} class="w-full h-full object-cover grayscale" />
        </div>
      </div>

            <div class="flex mt-1" style="height: 240px;">
        <div class="flex-1 overflow-hidden" style="border-radius:40px;">
          <img src={projects[0].imageUrl} alt={projects[0].title} class="w-full h-full object-cover grayscale" />
        </div>
        <div class="flex-1 overflow-hidden" style="border-radius: 40px;">
          <img src={projects[1].imageUrl} alt={projects[1].title} class="w-full h-full object-cover grayscale" />
        </div>
        <div class="flex-1 overflow-hidden" style="border-radius: 40px; background: #E5B769;">
          <img src={projects[2].imageUrl} alt={projects[2].title} class="w-full h-full object-cover #E5B769" />
        </div>
      </div>

    </div>
  </section>
</Layout>
